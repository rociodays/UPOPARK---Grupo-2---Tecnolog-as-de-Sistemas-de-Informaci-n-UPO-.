          </sheet>
        </form>
      </field>
    </record>
    <record id="action_evento_campus" model="ir.actions.act_window">
      <field name="name">Eventos Campus</field>
      <field name="res_model">upopark.evento_campus</field>
      <field name="view_mode">list,form</field>
    </record>
