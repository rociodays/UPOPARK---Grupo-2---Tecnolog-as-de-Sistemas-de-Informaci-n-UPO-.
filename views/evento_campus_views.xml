<odoo>
  <data><record id="view_evento_campus_list" model="ir.ui.view">
      <field name="name">upopark.evento_campus.list</field>
      <field name="model">upopark.evento_campus</field>
      <field name="arch" type="xml">
        <list string="Eventos Campus">
          <field name="snombre"/>
          <field name="dtfechainicio"/>
          <field name="dtfechafin"/>
        </list>
      </field>
    </record>
    <record id="view_evento_campus_form" model="ir.ui.view">
      <field name="name">upopark.evento_campus.form</field>
      <field name="model">upopark.evento_campus</field>
      <field name="arch" type="xml">
        <form string="Evento Campus">
          <sheet>
