<odoo>
  <data><record id="view_sancion_list" model="ir.ui.view">
      <field name="name">upopark.sancion.list</field>
      <field name="model">upopark.sancion</field>
      <field name="arch" type="xml">
        <list string="Sanciones">
          <field name="tipo_sancion_id"/>
          <field name="dfechainicio"/>
          <field name="dfechafin"/>
          <field name="smotivos"/>
        <field name="sestado" widget="badge"/></list>
      </field>
    </record>
    <record id="view_sancion_form" model="ir.ui.view">
      <field name="name">upopark.sancion.form</field>
      <field name="model">upopark.sancion</field>
      <field name="arch" type="xml">
        <form string="Sanción">
          <header><button name="btn_activar_sancion" string="Activar" type="object" class="oe_highlight" invisible="sestado != 'pendiente'"/><button name="btn_cumplir_sancion" string="Cumplir" type="object" class="oe_highlight" invisible="sestado != 'activa'"/><button name="btn_anular_sancion" string="Anular" type="object" invisible="sestado not in ('pendiente', 'activa')"/><field name="sestado" widget="statusbar" statusbar_visible="pendiente,activa,cumplida,anulada"/></header><sheet>
            <group>
              <field name="tipo_sancion_id"/>
              <field name="dfechainicio"/>
              <field name="dfechafin"/>
              <field name="smotivos"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="action_sancion" model="ir.actions.act_window">
      <field name="name">Sanciones</field>
      <field name="res_model">upopark.sancion</field>
      <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>
