<odoo>
  <record id="upoPark_materialPavimento_form_view" model="ir.ui.view">
    <field name="name">upoPark.materialPavimento.form</field>
    <field name="model">upoPark.materialPavimento</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="materialPavimento_aparcamiento" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoPark_materialPavimento_list_view" model="ir.ui.view">
    <field name="name">upoPark.materialPavimento.list</field>
    <field name="model">upoPark.materialPavimento</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="materialPavimento_aparcamiento" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="materialPavimento_list_action" model="ir.actions.act_window">
    <field name="name">Materiales de Pavimento</field>
    <field name="res_model">upopark.materialPavimento</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer material de pavimento</p>
    </field>
  </record>
</odoo>