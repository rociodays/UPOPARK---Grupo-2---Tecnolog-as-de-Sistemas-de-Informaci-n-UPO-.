<odoo>
  <record id="upopark_tipo_doc_form_view" model="ir.ui.view">
    <field name="name">upopark.tipo_doc.form</field>
    <field name="model">upopark.tipo_doc</field>
    <field name="arch" type="xml">
      <form string="Tipo de Documento">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="descripcion" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_tipo_doc_list_view" model="ir.ui.view">
    <field name="name">upopark.tipo_doc.list</field>
    <field name="model">upopark.tipo_doc</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="nombre" />
        <field name="descripcion" />
      </list>
    </field>
  </record>

  <record id="tipo_doc_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de Documento</field>
    <field name="res_model">upopark.tipo_doc</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first document type</p>
    </field>
  </record>
</odoo>