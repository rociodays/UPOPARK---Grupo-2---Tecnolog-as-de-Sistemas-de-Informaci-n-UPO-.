<odoo>
  <record id="upoPark_motivoBloqueo_form_view" model="ir.ui.view">
    <field name="name">upoPark.motivoBloqueo.form</field>
    <field name="model">upoPark.motivoBloqueo</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="motivo" />
            <field name="motivoBloqueo_bloqueoPlaza" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoPark_motivoBloqueo_list_view" model="ir.ui.view">
    <field name="name">upoPark.motivoBloqueo.list</field>
    <field name="model">upoPark.motivoBloqueo</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="motivo" />
            <field name="motivoBloqueo_bloqueoPlaza" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="motivoBloqueo_list_action" model="ir.actions.act_window">
    <field name="name">Motivos de bloqueo de plaza</field>
    <field name="res_model">upopark.motivoBloqueo</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer motivo de bloqueo de plaza</p>
    </field>
  </record>
</odoo>