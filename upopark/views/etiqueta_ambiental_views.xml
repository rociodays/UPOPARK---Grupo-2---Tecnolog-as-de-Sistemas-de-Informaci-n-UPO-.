<odoo>
    <record id="upopark_etiqueta_ambiental_form_view" model="ir.ui.view">
        <field name="name">upopark.etiqueta_ambiental.form</field>
        <field name="model">upopark.etiqueta_ambiental</field>
        <field name="arch" type="xml">
            <form string="Etiqueta Ambiental">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="color_distintivo" />
                        <field name="descripcion" />
                    </group>
                    <notebook>
                        <page string="Vehículos">
                            <field name="vehiculo_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_etiqueta_ambiental_list_view" model="ir.ui.view">
        <field name="name">upopark.etiqueta_ambiental.list</field>
        <field name="model">upopark.etiqueta_ambiental</field>
        <field name="arch" type="xml">
            <list string="Etiquetas Ambientales">
                <field name="name" />
                <field name="color_distintivo" />
            </list>
        </field>
    </record>
    <record id="etiqueta_ambiental_list_action" model="ir.actions.act_window">
        <field name="name">Etiquetas Ambientales</field>
        <field name="res_model">upopark.etiqueta_ambiental</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>