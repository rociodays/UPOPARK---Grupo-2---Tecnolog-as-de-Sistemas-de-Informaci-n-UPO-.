<odoo>
  <record id="upopark_usuario_form_view" model="ir.ui.view">
    <field name="name">upopark.usuario.form</field>
    <field name="model">upopark.usuario</field>
    <field name="arch" type="xml">
      <form string="Usuario">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="dni" />
            <field name="email" />
            <field name="organizacion_id" widget="many2one" />
            <field name="permiso_ids" widget="one2many" />
            <field name="sesion_ids" widget="one2many" />
            <field name="alegacion_ids" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_usuario_list_view" model="ir.ui.view">
    <field name="name">upopark.usuario.list</field>
    <field name="model">upopark.usuario</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="dni" />
        <field name="email" />
        <field name="organizacion_id" widget="many2one" />
      </list>
    </field>
  </record>

  <record id="usuario_list_action" model="ir.actions.act_window">
    <field name="name">Usuarios</field>
    <field name="res_model">upopark.usuario</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first user</p>
    </field>
  </record>
</odoo>