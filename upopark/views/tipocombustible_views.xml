<odoo>
    <record id="upopark_tipo_combustible_form_view" model="ir.ui.view">
        <field name="name">upopark.tipo_combustible.form</field>
        <field name="model">upopark.tipo_combustible</field>
        <field name="arch" type="xml">
            <form string="Tipo de Combustible">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="nombre" />
                    </group>
                    <notebook>
                        <page string="Vehículos">
                            <field name="vehiculo_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_tipo_combustible_list_view" model="ir.ui.view">
        <field name="name">upopark.tipo_combustible.list</field>
        <field name="model">upopark.tipo_combustible</field>
        <field name="arch" type="xml">
            <list string="Tipos de Combustible">
                <field name="name" />
                <field name="nombre" />
            </list>
        </field>
    </record>
    <record id="tipo_combustible_list_action" model="ir.actions.act_window">
        <field name="name">Tipos de Combustible</field>
        <field name="res_model">upopark.tipo_combustible</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>