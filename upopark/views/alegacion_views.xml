<odoo>
  <record id="upopark_alegacion_form_view" model="ir.ui.view">
    <field name="name">upopark.alegacion.form</field>
    <field name="model">upopark.alegacion</field>
    <field name="arch" type="xml">
      <form string="Alegación">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="argumento" />
            <field name="estado" />
            <field name="usuario_id"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_alegacion_list_view" model="ir.ui.view">
    <field name="name">upopark.alegacion.list</field>
    <field name="model">upopark.alegacion</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="estado" />
        <field name="usuario_id"  />
      </list>
    </field>
  </record>

  <record id="alegacion_list_action" model="ir.actions.act_window">
    <field name="name">Alegaciones</field>
    <field name="res_model">upopark.alegacion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first claim</p>
    </field>
  </record>
</odoo>