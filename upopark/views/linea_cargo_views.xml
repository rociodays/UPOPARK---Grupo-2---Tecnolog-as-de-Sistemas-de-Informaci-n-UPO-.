<odoo>
  <record id="upopark_linea_cargo_form_view" model="ir.ui.view">
    <field name="name">upopark.linea_cargo.form</field>
    <field name="model">upopark.linea_cargo</field>
    <field name="arch" type="xml">
      <form string="Línea de Cargo">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="importe_total" />
            <field name="sesion_id"  />
            <field name="tarifa_id"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_linea_cargo_list_view" model="ir.ui.view">
    <field name="name">upopark.linea_cargo.list</field>
    <field name="model">upopark.linea_cargo</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="importe_total" />
        <field name="tarifa_id"  />
      </list>
    </field>
  </record>

  <record id="upopark_linea_cargo_pivot_view" model="ir.ui.view">
    <field name="name">upopark.linea_cargo.pivot</field>
    <field name="model">upopark.linea_cargo</field>
    <field name="arch" type="xml">
      <pivot string="Análisis de Facturación">
        <field name="tarifa_id" type="row" />
        <field name="importe_total" type="measure" />
      </pivot>
    </field>
  </record>

  <record id="lineacargo_list_action" model="ir.actions.act_window">
    <field name="name">Líneas de Cargo</field>
    <field name="res_model">upopark.linea_cargo</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first charge line</p>
    </field>
  </record>
</odoo>