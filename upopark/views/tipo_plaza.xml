<odoo>
  <record id="upopark_tipo_plaza_form_view" model="ir.ui.view">
    <field name="name">upopark.tipo_plaza.form</field>
    <field name="model">upopark.tipo_plaza</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="requiere_vehiculo_electrico" />
            <field name="accesible" />
            <field name="tipo_plaza_plaza" widget="many2one" />
            <field name="tipo_plaza_organizacion" widget="Many2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_tipo_plaza_list_view" model="ir.ui.view">
    <field name="name">upopark.tipo_plaza.list</field>
    <field name="model">upopark.tipo_plaza</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="requiere_vehiculo_electrico" />
            <field name="accesible" />
            <field name="tipo_plaza_plaza" widget="many2one" />
            <field name="tipo_plaza_organizacion" widget="Many2one" />
      </list>
    </field>
  </record>

  <record id="tipo_plaza_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de plaza</field>
    <field name="res_model">upopark.tipo_plaza</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer tipo de plaza</p>
    </field>
  </record>
</odoo>