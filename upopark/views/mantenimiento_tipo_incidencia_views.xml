<odoo>
    <record id="view_mantenimiento_tipo_incidencia_list" model="ir.ui.view">
        <field name="name">upopark.mantenimiento.tipo_incidencia.list</field>
        <field name="model">upopark.mantenimiento.tipo_incidencia</field>
        <field name="arch" type="xml">
            <list>
                <field name="strNombre"/>
                <field name="strDescripcion"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_tipo_incidencia_form" model="ir.ui.view">
        <field name="name">upopark.mantenimiento.tipo_incidencia.form</field>
        <field name="model">upopark.mantenimiento.tipo_incidencia</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="strNombre"/>
                        <field name="strDescripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mantenimiento_tipo_incidencia" model="ir.actions.act_window">
        <field name="name">Tipos de incidencia</field>
        <field name="res_model">upopark.mantenimiento.tipo_incidencia</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
