<odoo>
  <data><record id="view_tipo_sancion_list" model="ir.ui.view">
      <field name="name">upopark.tipo_sancion.list</field>
      <field name="model">upopark.tipo_sancion</field>
      <field name="arch" type="xml">
        <list string="Tipos de Sanción">
          <field name="nombre"/>
          <field name="descripcion"/>
        </list>
      </field>
    </record>
    <record id="view_tipo_sancion_form" model="ir.ui.view">
      <field name="name">upopark.tipo_sancion.form</field>
      <field name="model">upopark.tipo_sancion</field>
      <field name="arch" type="xml">
        <form string="Tipo de Sanción">
          <sheet>
            <group>
              <field name="nombre"/>
              <field name="descripcion"/>
              <field name="sancion_ids"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="action_tipo_sancion" model="ir.actions.act_window">
      <field name="name">Tipos de Sanción</field>
      <field name="res_model">upopark.tipo_sancion</field>
      <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>
