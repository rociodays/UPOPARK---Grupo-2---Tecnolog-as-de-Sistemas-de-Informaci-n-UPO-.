<odoo>
  <record id="upopark_campus_form_view" model="ir.ui.view">
    <field name="name">upopark.campus.form</field>
    <field name="model">upopark.campus</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="direccion" />
            <field name="latitud" />
            <field name="longitud" />
            <field name="campus_organización" widget="many2one" />
            <field name="campus_aparcamiento" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_campus_list_view" model="ir.ui.view">
    <field name="name">upopark.campus.list</field>
    <field name="model">upopark.campus</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="direccion" />
            <field name="latitud" />
            <field name="longitud" />
            <field name="campus_organización" widget="many2one" />
            <field name="campus_aparcamiento" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="campus_list_action" model="ir.actions.act_window">
    <field name="name">Campus</field>
    <field name="res_model">upopark.campus</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer campus</p>
    </field>
  </record>

</odoo>