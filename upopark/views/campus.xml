<odoo>
  <record id="upoPark_campus_form_view" model="ir.ui.view">
    <field name="name">upoPark.campus.form</field>
    <field name="model">upoPark.campus</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="direccion" />
            <field name="latitud" />
            <field name="longitud" />
            <field name="campus_organización" widget="many2one" />
            <field name="campus_aparcamiento" widget="one2many">
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoPark_campus_list_view" model="ir.ui.view">
    <field name="name">upoPark.campus.list</field>
    <field name="model">upoPark.campus</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="direccion" />
            <field name="latitud" />
            <field name="longitud" />
            <field name="campus_organización" widget="many2one" />
            <field name="campus_aparcamiento" widget="one2many">
      </list>
    </field>
  </record>

</odoo>