<odoo>
  <record id="upopark_motivo_bloqueo_form_view" model="ir.ui.view">
    <field name="name">upopark.motivo_bloqueo.form</field>
    <field name="model">upopark.motivo_bloqueo</field>
    <field name="arch" type="xml">
      <form string="Motivo de Bloqueo">
        <sheet>
          <group>
            <field name="motivo"/>
            <field name="descripcion"/>
            <field name="bloqueo_plaza_ids"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_motivo_bloqueo_list_view" model="ir.ui.view">
    <field name="name">upopark.motivo_bloqueo.list</field>
    <field name="model">upopark.motivo_bloqueo</field>
    <field name="arch" type="xml">
      <list string="Motivos de Bloqueo">
        <field name="motivo"/>
        <field name="descripcion"/>
      </list>
    </field>
  </record>

  <record id="motivo_bloqueo_list_action" model="ir.actions.act_window">
    <field name="name">Motivos de Bloqueo</field>
    <field name="res_model">upopark.motivo_bloqueo</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>