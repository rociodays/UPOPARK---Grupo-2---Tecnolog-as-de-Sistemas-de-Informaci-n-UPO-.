<odoo>
    <record id="view_estado_permiso_list" model="ir.ui.view">
        <field name="name">upopark.estado_permiso.list</field>
        <field name="model">upopark.estado_permiso</field>
        <field name="arch" type="xml">
            <list string="Estados de Permiso">
                <field name="permiso_acceso_id"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'aprobado'"
                       decoration-danger="estado == 'denegado'"
                       decoration-warning="estado == 'pendiente'"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="view_estado_permiso_form" model="ir.ui.view">
        <field name="name">upopark.estado_permiso.form</field>
        <field name="model">upopark.estado_permiso</field>
        <field name="arch" type="xml">
            <form string="Estado de Permiso">
                <sheet>
                    <group>
                        <field name="permiso_acceso_id"/>
                        <field name="estado"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estado_permiso_search" model="ir.ui.view">
        <field name="name">upopark.estado_permiso.search</field>
        <field name="model">upopark.estado_permiso</field>
        <field name="arch" type="xml">
            <search>
                <field name="permiso_acceso_id"/>
                <field name="estado"/>
                <filter name="filter_aprobado" string="Aprobados" domain="[('estado','=','aprobado')]"/>
                <filter name="filter_denegado" string="Denegados" domain="[('estado','=','denegado')]"/>
                <filter name="filter_pendiente" string="Pendientes" domain="[('estado','=','pendiente')]"/>
            </search>
        </field>
    </record>

    <record id="action_estado_permiso" model="ir.actions.act_window">
        <field name="name">Estados de Permiso</field>
        <field name="res_model">upopark.estado_permiso</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>