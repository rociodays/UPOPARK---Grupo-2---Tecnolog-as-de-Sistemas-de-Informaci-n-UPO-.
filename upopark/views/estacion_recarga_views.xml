<odoo>
  <record id="upopark_estacion_recarga_form_view" model="ir.ui.view">
    <field name="name">upopark.estacion_recarga.form</field>
    <field name="model">upopark.estacion_recarga</field>
    <field name="arch" type="xml">
      <form string="Estación de Recarga">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="estado" />
            <field name="conector_ids" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_estacion_recarga_list_view" model="ir.ui.view">
    <field name="name">upopark.estacion_recarga.list</field>
    <field name="model">upopark.estacion_recarga</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="estado" />
        <field name="conector_ids" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="estacionrecarga_list_action" model="ir.actions.act_window">
    <field name="name">Estaciones de Recarga</field>
    <field name="res_model">upopark.estacion_recarga</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first charging station</p>
    </field>
  </record>
</odoo>