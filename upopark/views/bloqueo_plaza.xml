<odoo>
  <record id="upopark_bloqueo_plaza_form_view" model="ir.ui.view">
    <field name="name">upopark.bloqueo_plaza.form</field>
    <field name="model">upopark.bloqueo_plaza</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="referencia" />
            <field name="inicio" />
            <field name="fin" />
            <field name="activo" />
            <field name="bloqueo_plaza_plaza" widget="Many2one" />
            <field name="bloqueo_plaza_motivo_bloqueo" widget="Many2one" />
            <field name="bloqueo_plaza_incidencia" widget="Many2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_bloqueo_plaza_list_view" model="ir.ui.view">
    <field name="name">upopark.bloqueo_plaza.list</field>
    <field name="model">upopark.bloqueo_plaza</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="referencia" />
            <field name="inicio" />
            <field name="fin" />
            <field name="activo" />
            <field name="bloqueo_plaza_plaza" widget="Many2one" />
            <field name="bloqueo_plaza_motivo_bloqueo" widget="Many2one" />
            <field name="bloqueo_plaza_incidencia" widget="Many2one" />
      </list>
    </field>
  </record>

  <record id="bloqueo_plaza_list_action" model="ir.actions.act_window">
    <field name="name">Bloqueos de plaza</field>
    <field name="res_model">upopark.bloqueo_plaza</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer bloqueo de plaza</p>
    </field>
  </record>
</odoo>