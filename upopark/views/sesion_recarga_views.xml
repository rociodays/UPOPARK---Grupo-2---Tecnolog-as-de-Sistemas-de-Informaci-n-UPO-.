<odoo>
  <record id="upopark_sesion_recarga_form_view" model="ir.ui.view">
    <field name="name">upopark.sesion_recarga.form</field>
    <field name="model">upopark.sesion_recarga</field>
    <field name="arch" type="xml">
      <form string="Sesión de Recarga">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="fecha" />
            <field name="kw_consumidos" />
            <field name="usuario_id"  />
            <field name="conector_id"  />
            <field name="linea_cargo_ids"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_sesion_recarga_list_view" model="ir.ui.view">
    <field name="name">upopark.sesion_recarga.list</field>
    <field name="model">upopark.sesion_recarga</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="fecha" />
        <field name="kw_consumidos" />
        <field name="usuario_id"  />
      </list>
    </field>
  </record>

  <record id="upopark_sesion_recarga_graph_view" model="ir.ui.view">
    <field name="name">upopark.sesion_recarga.graph</field>
    <field name="model">upopark.sesion_recarga</field>
    <field name="arch" type="xml">
      <graph string="Consumo Eléctrico" type="bar">
        <field name="fecha" type="row" interval="day" />
        <field name="kw_consumidos" type="measure" />
      </graph>
    </field>
  </record>

  <record id="sesionrecarga_list_action" model="ir.actions.act_window">
    <field name="name">Sesiones de Recarga</field>
    <field name="res_model">upopark.sesion_recarga</field>
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first charging session</p>
    </field>
  </record>
</odoo>