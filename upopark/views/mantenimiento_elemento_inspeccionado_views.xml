<odoo>
    <record id="view_mantenimiento_elemento_inspeccionado_list" model="ir.ui.view">
        <field name="name">upopark.mantenimiento.elemento_inspeccionado.list</field>
        <field name="model">upopark.mantenimiento.elemento_inspeccionado</field>
        <field name="arch" type="xml">
            <list>
                <field name="iSecuencia"/>
                <field name="strNombre"/>
                <field name="m2oInspeccionId"/>
                <field name="selResultado"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_elemento_inspeccionado_form" model="ir.ui.view">
        <field name="name">upopark.mantenimiento.elemento_inspeccionado.form</field>
        <field name="model">upopark.mantenimiento.elemento_inspeccionado</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="m2oInspeccionId" options="{'no_create': True}"/>
                        <field name="strNombre"/>
                        <field name="iSecuencia"/>
                        <field name="selResultado"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mantenimiento_elemento_inspeccionado" model="ir.actions.act_window">
        <field name="name">Puntos de comprobación</field>
        <field name="res_model">upopark.mantenimiento.elemento_inspeccionado</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
