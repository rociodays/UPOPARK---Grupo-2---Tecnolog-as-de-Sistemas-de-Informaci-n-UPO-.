<odoo>
  <record id="upoPark_bloqueoPlaza_form_view" model="ir.ui.view">
    <field name="name">upoPark.bloqueoPlaza.form</field>
    <field name="model">upoPark.bloqueoPlaza</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="inicio" />
            <field name="fin" />
            <field name="activo" />
            <field name="bloqueoPlaza_plaza" widget="one2one" />
            <field name="bloqueoPlaza_motivoBloqueo" widget="one2one">
            <field name="bloqueoPlaza_incidencia" widget="one2one">
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoPark_bloqueoPlaza_list_view" model="ir.ui.view">
    <field name="name">upoPark.bloqueoPlaza.list</field>
    <field name="model">upoPark.bloqueoPlaza</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="inicio" />
            <field name="fin" />
            <field name="activo" />
            <field name="bloqueoPlaza_plaza" widget="one2one" />
            <field name="bloqueoPlaza_motivoBloqueo" widget="one2one">
            <field name="bloqueoPlaza_incidencia" widget="one2one">
      </list>
    </field>
  </record>

</odoo>