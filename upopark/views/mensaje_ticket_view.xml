<odoo>
  <record id="upopark_mensaje_ticket_form_view" model="ir.ui.view">
    <field name="name">upopark.mensaje_ticket.form</field>
    <field name="model">upopark.mensaje_ticket</field>
    <field name="arch" type="xml">
      <form string="Mensaje Ticket">
        <sheet layout="auto">
          <group>
            <field name="fecha_hora" />
            <field name="texto" />
            <field name="comentario" />
            <field name="ticket_id"  />
            <field name="contacto_id"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_mensaje_ticket_list_view" model="ir.ui.view">
    <field name="name">upopark.mensaje_ticket.list</field>
    <field name="model">upopark.mensaje_ticket</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="fecha_hora" />
        <field name="texto" />
        <field name="ticket_id"  />
      </list>
    </field>
  </record>

  <record id="mensaje_ticket_list_action" model="ir.actions.act_window">
    <field name="name">Mensajes de Ticket</field>
    <field name="res_model">upopark.mensaje_ticket</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first message</p>
    </field>
  </record>
</odoo>
