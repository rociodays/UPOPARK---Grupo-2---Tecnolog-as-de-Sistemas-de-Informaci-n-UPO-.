<odoo>
    <record id="view_estancia_list" model="ir.ui.view">
        <field name="name">upopark.estancia.list</field>
        <field name="model">upopark.estancia</field>
        <field name="arch" type="xml">
            <list string="Estancias">
                <field name="referencia"/>
                <field name="entrada"/>
                <field name="salida"/>
                <field name="cargo_id"/>
                <field name="conector_id"/>
                <field name="estado_estancia_id"/>
            </list>
        </field>
    </record>

    <record id="view_estancia_form" model="ir.ui.view">
        <field name="name">upopark.estancia.form</field>
        <field name="model">upopark.estancia</field>
        <field name="arch" type="xml">
            <form string="Estancia">
                <header>
                    <field name="estado_estancia_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="referencia"/>
                            <field name="entrada"/>
                            <field name="salida"/>
                        </group>
                        <group>
                            <field name="cargo_id"/>
                            <field name="conector_id"/>
                            <field name="sesion_carga_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Punto de Acceso (Comienza)">
                            <field name="punto_acceso_comienza_id">
                                <list/>
                            </field>
                        </page>
                        <page string="Punto de Acceso (Finaliza)">
                            <field name="punto_acceso_finaliza_id">
                                <list/>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estancia_search" model="ir.ui.view">
        <field name="name">upopark.estancia.search</field>
        <field name="model">upopark.estancia</field>
        <field name="arch" type="xml">
            <search>
                <field name="referencia"/>
                <field name="cargo_id"/>
                <field name="conector_id"/>
                <filter name="filter_en_curso" string="En curso" domain="[('salida','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado_estancia_id'}"/>
                    <filter name="group_conector" string="Conector" context="{'group_by': 'conector_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_estancia" model="ir.actions.act_window">
        <field name="name">Estancias</field>
        <field name="res_model">upopark.estancia</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>