<odoo>
  <record id="upopark_plaza_form_view" model="ir.ui.view">
    <field name="name">upopark.plaza.form</field>
    <field name="model">upopark.plaza</field>
    <field name="arch" type="xml">
      <form string="Plaza">
        <sheet>
          <group>
            <field name="codigo"/>
            <field name="longitud"/>
            <field name="anchura"/>
            <field name="plaza_bloqueo_plaza"/>
            <field name="plaza_aparcamiento"/>
            <field name="plaza_estado_plaza"/>
            <field name="plaza_conector"/>
            <field name="plaza_sensor_ocupacion"/>
            <field name="plaza_estado_conservacion"/>
            <field name="tipo_plaza_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_plaza_list_view" model="ir.ui.view">
    <field name="name">upopark.plaza.list</field>
    <field name="model">upopark.plaza</field>
    <field name="arch" type="xml">
      <list string="Plazas">
        <field name="codigo"/>
        <field name="longitud"/>
        <field name="anchura"/>
        <field name="plaza_aparcamiento"/>
        <field name="plaza_estado_plaza"/>
        <field name="plaza_estado_conservacion"/>
        <field name="tipo_plaza_id"/>
      </list>
    </field>
  </record>

  <record id="plaza_list_action" model="ir.actions.act_window">
    <field name="name">Plazas</field>
    <field name="res_model">upopark.plaza</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>