<odoo>
    <record id="upopark_tipo_conector_form_view" model="ir.ui.view">
        <field name="name">upopark.tipo_conector.form</field>
        <field name="model">upopark.tipo_conector</field>
        <field name="arch" type="xml">
            <form string="Tipo de Conector">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="nombre" />
                        <field name="corriente" />
                    </group>
                    <notebook>
                        <page string="Conectores">
                            <field name="conector_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_tipo_conector_list_view" model="ir.ui.view">
        <field name="name">upopark.tipo_conector.list</field>
        <field name="model">upopark.tipo_conector</field>
        <field name="arch" type="xml">
            <list string="Tipos de Conectores">
                <field name="name" />
                <field name="nombre" />
                <field name="corriente" />
            </list>
        </field>
    </record>
    <record id="tipo_conector_list_action" model="ir.actions.act_window">
        <field name="name">Tipos de Conectores</field>
        <field name="res_model">upopark.tipo_conector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>