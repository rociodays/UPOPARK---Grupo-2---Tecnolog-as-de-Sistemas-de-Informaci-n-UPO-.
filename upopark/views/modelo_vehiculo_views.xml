<odoo>
    <record id="view_modelo_vehiculo_list" model="ir.ui.view">
        <field name="name">upopark.modelo_vehiculo.list</field>
        <field name="model">upopark.modelo_vehiculo</field>
        <field name="arch" type="xml">
            <list string="Modelos de Vehículo">
                <field name="nombre_modelo"/>
                <field name="descripcion"/>
                <field name="vehiculo_id"/>
            </list>
        </field>
    </record>

    <record id="view_modelo_vehiculo_form" model="ir.ui.view">
        <field name="name">upopark.modelo_vehiculo.form</field>
        <field name="model">upopark.modelo_vehiculo</field>
        <field name="arch" type="xml">
            <form string="Modelo de Vehiculo">
                <sheet>
                    <group>
                        <field name="nombre_modelo"/>
                        <field name="vehiculo_id"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_modelo_vehiculo_search" model="ir.ui.view">
        <field name="name">upopark.modelo_vehiculo.search</field>
        <field name="model">upopark.modelo_vehiculo</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre_modelo"/>
                <field name="vehiculo_id"/>
            </search>
        </field>
    </record>

    <record id="action_modelo_vehiculo" model="ir.actions.act_window">
        <field name="name">Modelos de Vehículo</field>
        <field name="res_model">upopark.modelo_vehiculo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>