<odoo>
    <record id="view_mantenimiento_tarea_list" model="ir.ui.view">
        <field name="name">upopark.tarea.list</field>
        <field name="model">upopark.tarea</field>
        <field name="arch" type="xml">
            <list>
                <field name="iSecuencia"/>
                <field name="strNombre"/>
                <field name="orden_trabajo_id"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_tarea_form" model="ir.ui.view">
        <field name="name">upopark.tarea.form</field>
        <field name="model">upopark.tarea</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="orden_trabajo_id" options="{'no_create': True}"/>
                        <field name="strNombre"/>
                        <field name="iSecuencia"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mantenimiento_tarea" model="ir.actions.act_window">
        <field name="name">Tareas de mantenimiento</field>
        <field name="res_model">upopark.tarea</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
