<odoo>
    <record id="view_mantenimiento_plan_preventivo_list" model="ir.ui.view">
        <field name="name">upopark.plan_preventivo.list</field>
        <field name="model">upopark.plan_preventivo</field>
        <field name="arch" type="xml">
            <list>
                <field name="strCodigo"/>
                <field name="recurso_id"/>
                <field name="strDescripcion"/>
            </list>
        </field>
    </record>
    <record id="view_mantenimiento_plan_preventivo_form" model="ir.ui.view">
        <field name="name">upopark.plan_preventivo.form</field>
        <field name="model">upopark.plan_preventivo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="strCodigo"/>
                        <field name="recurso_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="strDescripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mantenimiento_plan_preventivo_search" model="ir.ui.view">
        <field name="name">upopark.plan_preventivo.search</field>
        <field name="model">upopark.plan_preventivo</field>
        <field name="arch" type="xml">
            <search>
                <field name="strCodigo"/>
                <field name="recurso_id"/>
                <field name="strDescripcion"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_recurso" string="Recurso" context="{'group_by': 'recurso_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_mantenimiento_plan_preventivo_graph" model="ir.ui.view">
        <field name="name">upopark.plan_preventivo.graph</field>
        <field name="model">upopark.plan_preventivo</field>
        <field name="arch" type="xml">
            <graph string="Planes por recurso" type="bar">
                <field name="recurso_id"/>
            </graph>
        </field>
    </record>
    <record id="action_mantenimiento_plan_preventivo" model="ir.actions.act_window">
        <field name="name">Planes preventivos</field>
        <field name="res_model">upopark.plan_preventivo</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_mantenimiento_plan_preventivo_search"/>
    </record>
</odoo>
