<odoo>
  <record id="upopark_reserva_form_view" model="ir.ui.view">
    <field name="name">upopark.reserva.form</field>
    <field name="model">upopark.reserva</field>
    <field name="arch" type="xml">
      <form string="Reserva">
        <sheet layout="auto">
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="RES-YYYY-XXXX" />
            </h1>
          </div>
          <group>
            <group>
              <field name="contacto_id" widget="many2one" />
              <field name="vehiculo_id" widget="many2one" />
              <field name="plaza_id" widget="many2one" />
              <field name="politica_reserva_id" widget="many2one" />
              <field name="estado_reserva_id" widget="many2one" />
            </group>
            <group>
              <field name="fInicio" />
              <field name="fFin" />
            </group>
          </group>
          <notebook>
            <page name="historial_cambios" string="Historial de Cambios">
              <group>
                <field name="historial_ids" widget="one2many" />
              </group>
            </page>
            <page name="registros_cancelacion" string="Registros de Cancelacion">
              <group>
                <field name="cancelacion_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_reserva_list_view" model="ir.ui.view">
    <field name="name">upopark.reserva.list</field>
    <field name="model">upopark.reserva</field>
    <field name="arch" type="xml">
      <list string="Reservas">
        <field name="name" />
        <field name="contacto_id" />
        <field name="vehiculo_id" />
        <field name="plaza_id" />
        <field name="fInicio" />
        <field name="fFin" />
        <field name="estado_reserva_id" />
      </list>
    </field>
  </record>

  <record id="reserva_list_action" model="ir.actions.act_window">
    <field name="name">Reservas</field>
    <field name="res_model">upopark.reserva</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Crea la primera reserva en el sistema</p>
    </field>
  </record>
</odoo>