<odoo>
  <record id="upopark_prioridad_form_view" model="ir.ui.view">
    <field name="name">upopark.prioridad.form</field>
    <field name="model">upopark.prioridad</field>
    <field name="arch" type="xml">
      <form string="Prioridad">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="descripcion" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_prioridad_list_view" model="ir.ui.view">
    <field name="name">upopark.prioridad.list</field>
    <field name="model">upopark.prioridad</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="nombre" />
        <field name="descripcion" />
      </list>
    </field>
  </record>

  <record id="prioridad_list_action" model="ir.actions.act_window">
    <field name="name">Prioridades</field>
    <field name="res_model">upopark.prioridad</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first priority</p>
    </field>
  </record>
</odoo>