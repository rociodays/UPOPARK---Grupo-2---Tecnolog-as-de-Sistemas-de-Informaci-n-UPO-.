<odoo>
  <record id="upopark_calendario_form_view" model="ir.ui.view">
    <field name="name">upopark.calendario.form</field>
    <field name="model">upopark.calendario</field>
    <field name="arch" type="xml">
      <form string="Calendario">
        <sheet layout="auto">
          <group>
            <field name="codigo" />
            <field name="nombre" />
            <field name="zona_horaria" />
            <field name="activo" />
            <field name="organizacion_id"  />
          </group>
          <notebook>
            <page string="Franjas"><field name="franja_ids"/></page>
            <page string="Recursos"><field name="recurso_ids"/></page>
            <page string="Eventos"><field name="evento_ids"/></page>
            <page string="Festivos"><field name="festivo_ids"/></page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_calendario_list_view" model="ir.ui.view">
    <field name="name">upopark.calendario.list</field>
    <field name="model">upopark.calendario</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="codigo" />
        <field name="nombre" />
        <field name="zona_horaria" />
        <field name="activo" />
      </list>
    </field>
  </record>

  <record id="calendario_list_action" model="ir.actions.act_window">
    <field name="name">Calendarios</field>
    <field name="res_model">upopark.calendario</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first calendar</p>
    </field>
  </record>
</odoo>
