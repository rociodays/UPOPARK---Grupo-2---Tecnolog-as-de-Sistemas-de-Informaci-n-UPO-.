<odoo>
    <record id="view_fabricante_hardware_list" model="ir.ui.view">
        <field name="name">upopark.fabricante_hardware.list</field>
        <field name="model">upopark.fabricante_hardware</field>
        <field name="arch" type="xml">
            <list string="Fabricantes de Hardware">
                <field name="nombre"/>
                <field name="soporte_tecnico"/>
                <field name="web" widget="url"/>
            </list>
        </field>
    </record>

    <record id="view_fabricante_hardware_form" model="ir.ui.view">
        <field name="name">upopark.fabricante_hardware.form</field>
        <field name="model">upopark.fabricante_hardware</field>
        <field name="arch" type="xml">
            <form string="Fabricante de Hardware">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="soporte_tecnico"/>
                        <field name="web" widget="url"/>
                    </group>
                    <notebook>
                        <page string="Conectores">
                            <field name="conector_ids">
                                <list/>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fabricante_hardware_search" model="ir.ui.view">
        <field name="name">upopark.fabricante_hardware.search</field>
        <field name="model">upopark.fabricante_hardware</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="soporte_tecnico"/>
            </search>
        </field>
    </record>

    <record id="action_fabricante_hardware" model="ir.actions.act_window">
        <field name="name">Fabricantes de Hardware</field>
        <field name="res_model">upopark.fabricante_hardware</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>