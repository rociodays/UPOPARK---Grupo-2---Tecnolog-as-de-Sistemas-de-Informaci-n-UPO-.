<odoo>
  <record id="upopark_color_vehiculo_form_view" model="ir.ui.view">
    <field name="name">upopark.color_vehiculo.form</field>
    <field name="model">upopark.color_vehiculo</field>
    <field name="arch" type="xml">
      <form string="Color de Vehiculo">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="cDescripcion" />
          </group>
          <notebook>
            <page name="vehiculos_registrados" string="Vehiculos Registrados">
              <group>
                <field name="vehiculo_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_color_vehiculo_list_view" model="ir.ui.view">
    <field name="name">upopark.color_vehiculo.list</field>
    <field name="model">upopark.color_vehiculo</field>
    <field name="arch" type="xml">
      <list string="Colores de Vehiculos">
        <field name="name" />
        <field name="cDescripcion" />
      </list>
    </field>
  </record>

  <record id="upopark_color_vehiculo_graph_view" model="ir.ui.view">
    <field name="name">upopark.color_vehiculo.graph</field>
    <field name="model">upopark.color_vehiculo</field>
    <field name="arch" type="xml">
      <graph string="Colores de Vehiculos" type="bar">
        <field name="name" type="row" />
      </graph>
    </field>
  </record>

  <record id="upopark_color_vehiculo_search_view" model="ir.ui.view">
    <field name="name">upopark.color_vehiculo.search</field>
    <field name="model">upopark.color_vehiculo</field>
    <field name="arch" type="xml">
      <search>
        <filter name="colores_vacios" string="Colores sin Vehiculos registrados" domain="[('vehiculo_ids', '=', False)]" />
      </search>
    </field>
  </record>

  <record id="color_vehiculo_list_action" model="ir.actions.act_window">
    <field name="name">Colores de Vehiculo</field>
    <field name="res_model">upopark.color_vehiculo</field>
    <field name="view_mode">list,form,graph</field>
    <field name="search_view_id" ref="upopark_color_vehiculo_search_view" />
    <field name="help" type="html">
      <p>Crea el primer color de vehiculo en el sistema</p>
    </field>
  </record>
</odoo>