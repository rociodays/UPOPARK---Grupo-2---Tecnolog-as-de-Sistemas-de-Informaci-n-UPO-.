<odoo>
    <record id="view_mantenimiento_orden_trabajo_list" model="ir.ui.view">
        <field name="name">upopark.orden_trabajo.list</field>
        <field name="model">upopark.orden_trabajo</field>
        <field name="arch" type="xml">
            <list>
                <field name="strReferencia"/>
                <field name="strAsunto"/>
                <field name="dtInicioPrevisto"/>
                <field name="responsable_id"/>
                <field name="incidencia_id"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_orden_trabajo_form" model="ir.ui.view">
        <field name="name">upopark.orden_trabajo.form</field>
        <field name="model">upopark.orden_trabajo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_mantenimiento_inspeccion_new)d" type="action"
                            string="Abrir inspección" context="{'default_orden_trabajo_id': id}"
                            invisible="not id"/>
                </header>
                <sheet>
                    <group>
                        <field name="strReferencia" invisible="not id"/>
                        <field name="strAsunto"/>
                        <field name="dtInicioPrevisto"/>
                        <field name="responsable_id" options="{'no_create': True}"/>
                        <field name="incidencia_id" options="{'no_create': True}"/>
                    </group>
                    <field name="tarea_ids">
                        <list editable="bottom" delete="0">
                            <field name="iSecuencia"/>
                            <field name="strNombre"/>
                        </list>
                    </field>
                    <field name="inspeccion_ids" readonly="1">
                        <list>
                            <field name="strReferencia"/>
                            <field name="inspector_id"/>
                            <field name="dateFechaInspeccion"/>
                            <field name="resultado_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mantenimiento_orden_trabajo_calendar" model="ir.ui.view">
        <field name="name">upopark.orden_trabajo.calendar</field>
        <field name="model">upopark.orden_trabajo</field>
        <field name="arch" type="xml">
            <calendar string="Órdenes programadas" date_start="dtInicioPrevisto"
                      color="responsable_id" quick_create="false" delete="false">
                <field name="strAsunto"/>
                <field name="responsable_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_mantenimiento_orden_trabajo" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">upopark.orden_trabajo</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="action_mantenimiento_orden_trabajo_new" model="ir.actions.act_window">
        <field name="name">Abrir orden de trabajo</field>
        <field name="res_model">upopark.orden_trabajo</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
