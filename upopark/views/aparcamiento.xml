<odoo>
  <record id="upopark_aparcamiento_form_view" model="ir.ui.view">
    <field name="name">upopark.aparcamiento.form</field>
    <field name="model">upopark.aparcamiento</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="capacidad" />
            <field name="activo" />
            <field name="aparcamiento_campus"  />
            <field name="aparcamiento_zona"  />
            <field name="aparcamiento_plaza"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_aparcamiento_list_view" model="ir.ui.view">
    <field name="name">upopark.aparcamiento.list</field>
    <field name="model">upopark.aparcamiento</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="capacidad" />
            <field name="activo" />
            <field name="aparcamiento_campus"  />
            <field name="aparcamiento_zona"  />
            <field name="aparcamiento_plaza"  />
      </list>
    </field>
  </record>

  <record id="aparcamiento_list_action" model="ir.actions.act_window">
    <field name="name">Aparcamientos</field>
    <field name="res_model">upopark.aparcamiento</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer aparcamiento</p>
    </field>
  </record>

</odoo>