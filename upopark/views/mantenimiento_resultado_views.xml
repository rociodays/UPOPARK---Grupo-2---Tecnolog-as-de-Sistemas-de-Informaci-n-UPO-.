<odoo>
    <record id="view_mantenimiento_resultado_list" model="ir.ui.view">
        <field name="name">upopark.resultado.list</field>
        <field name="model">upopark.resultado</field>
        <field name="arch" type="xml">
            <list>
                <field name="strNombre"/>
                <field name="strDescripcion"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_resultado_form" model="ir.ui.view">
        <field name="name">upopark.resultado.form</field>
        <field name="model">upopark.resultado</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="strNombre"/>
                        <field name="strDescripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mantenimiento_resultado" model="ir.actions.act_window">
        <field name="name">Resultados de inspección</field>
        <field name="res_model">upopark.resultado</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
