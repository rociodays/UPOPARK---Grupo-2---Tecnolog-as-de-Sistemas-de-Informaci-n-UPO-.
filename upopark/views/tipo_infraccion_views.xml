<odoo>
  <data><record id="view_tipo_infraccion_list" model="ir.ui.view">
      <field name="name">upopark.tipo_infraccion.list</field>
      <field name="model">upopark.tipo_infraccion</field>
      <field name="arch" type="xml">
        <list string="Tipos de Infracción">
          <field name="gravedad"/>
          <field name="importe_sugerido"/>
        </list>
      </field>
    </record>
    <record id="view_tipo_infraccion_form" model="ir.ui.view">
      <field name="name">upopark.tipo_infraccion.form</field>
      <field name="model">upopark.tipo_infraccion</field>
      <field name="arch" type="xml">
        <form string="Tipo de Infracción">
          <sheet>
            <group>
              <field name="gravedad"/>
              <field name="importe_sugerido"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="action_tipo_infraccion" model="ir.actions.act_window">
      <field name="name">Tipos de Infracción</field>
      <field name="res_model">upopark.tipo_infraccion</field>
      <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>
