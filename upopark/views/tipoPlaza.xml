<odoo>
  <record id="upoPark_tipoPlaza_form_view" model="ir.ui.view">
    <field name="name">upoPark.tipoPlaza.form</field>
    <field name="model">upoPark.tipoPlaza</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="requiere_vehiculo_electrico" />
            <field name="accesible" />
            <field name="tipoPlaza_plaza" widget="many2one" />
            <field name="tipoPlaza_organizacion" widget="one2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upoPark_tipoPlaza_list_view" model="ir.ui.view">
    <field name="name">upoPark.tipoPlaza.list</field>
    <field name="model">upoPark.tipoPlaza</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="requiere_vehiculo_electrico" />
            <field name="accesible" />
            <field name="tipoPlaza_plaza" widget="many2one" />
            <field name="tipoPlaza_organizacion" widget="one2one" />
      </list>
    </field>
  </record>

  <record id="tipoPlaza_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de plaza</field>
    <field name="res_model">upopark.tipoPlaza</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer tipo de plaza</p>
    </field>
  </record>
</odoo>