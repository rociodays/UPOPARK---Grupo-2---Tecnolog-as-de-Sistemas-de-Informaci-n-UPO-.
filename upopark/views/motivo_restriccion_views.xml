<odoo>
  <record id="upopark_motivo_restriccion_form_view" model="ir.ui.view">
    <field name="name">upopark.motivo_restriccion.form</field>
    <field name="model">upopark.motivo_restriccion</field>
    <field name="arch" type="xml">
      <form string="Motivo de Restriccion">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="cDescripcion" />
          </group>
          <notebook>
            <page name="restricciones_aplicadas" string="Restricciones Aplicadas">
              <group>
                <field name="restriccion_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_motivo_restriccion_list_view" model="ir.ui.view">
    <field name="name">upopark.motivo_restriccion.list</field>
    <field name="model">upopark.motivo_restriccion</field>
    <field name="arch" type="xml">
      <list string="Motivos de Restriccion">
        <field name="name" />
        <field name="cDescripcion" />
      </list>
    </field>
  </record>

  <record id="motivo_restriccion_list_action" model="ir.actions.act_window">
    <field name="name">Motivos de Restriccion</field>
    <field name="res_model">upopark.motivo_restriccion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Crea el primer motivo de restriccion en el sistema</p>
    </field>
  </record>
</odoo>