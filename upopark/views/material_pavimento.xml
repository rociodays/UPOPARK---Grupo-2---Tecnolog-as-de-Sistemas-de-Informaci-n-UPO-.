<odoo>
  <record id="upopark_material_pavimento_form_view" model="ir.ui.view">
    <field name="name">upopark.material_pavimento.form</field>
    <field name="model">upopark.material_pavimento</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="material_pavimento_aparcamiento" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_material_pavimento_list_view" model="ir.ui.view">
    <field name="name">upopark.material_pavimento.list</field>
    <field name="model">upopark.material_pavimento</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="material_pavimento_aparcamiento" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="material_pavimento_list_action" model="ir.actions.act_window">
    <field name="name">Materiales de Pavimento</field>
    <field name="res_model">upopark.material_pavimento</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer material de pavimento</p>
    </field>
  </record>
</odoo>