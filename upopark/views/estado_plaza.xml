<odoo>
  <record id="upopark_estado_plaza_form_view" model="ir.ui.view">
    <field name="name">upopark.estado_plaza.form</field>
    <field name="model">upopark.estado_plaza</field>
    <field name="arch" type="xml">
      <form string="Estado de Plaza">
        <sheet>
          <group>
            <field name="estado"/>
            <field name="plaza_ids"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_estado_plaza_list_view" model="ir.ui.view">
    <field name="name">upopark.estado_plaza.list</field>
    <field name="model">upopark.estado_plaza</field>
    <field name="arch" type="xml">
      <list string="Estados de Plaza">
        <field name="estado"/>
      </list>
    </field>
  </record>

  <record id="estado_plaza_list_action" model="ir.actions.act_window">
    <field name="name">Estados de Plaza</field>
    <field name="res_model">upopark.estado_plaza</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>