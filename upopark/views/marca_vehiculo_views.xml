<odoo>
    <record id="upopark_marca_vehiculo_form_view" model="ir.ui.view">
        <field name="name">upopark.marca_vehiculo.form</field>
        <field name="model">upopark.marca_vehiculo</field>
        <field name="arch" type="xml">
            <form string="Marca de Vehículo">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="pais_origen" />
                    </group>
                    <notebook>
                        <page string="Vehículos">
                            <field name="vehiculo_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_marca_vehiculo_list_view" model="ir.ui.view">
        <field name="name">upopark.marca_vehiculo.list</field>
        <field name="model">upopark.marca_vehiculo</field>
        <field name="arch" type="xml">
            <list string="Marcas de Vehículos">
                <field name="name" />
                <field name="pais_origen" />
            </list>
        </field>
    </record>
    <record id="marca_vehiculo_list_action" model="ir.actions.act_window">
        <field name="name">Marcas de Vehículos</field>
        <field name="res_model">upopark.marca_vehiculo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>