<odoo>
  <data><record id="view_metodo_pago_list" model="ir.ui.view">
      <field name="name">upopark.metodo_pago.list</field>
      <field name="model">upopark.metodo_pago</field>
      <field name="arch" type="xml">
        <list string="Métodos de Pago">
          <field name="metodo"/>
          <field name="comision"/>
          <field name="descripcion"/>
        </list>
      </field>
    </record>
    <record id="view_metodo_pago_form" model="ir.ui.view">
      <field name="name">upopark.metodo_pago.form</field>
      <field name="model">upopark.metodo_pago</field>
      <field name="arch" type="xml">
        <form string="Método de Pago">
          <sheet>
            <group>
              <field name="metodo"/>
              <field name="comision"/>
              <field name="descripcion"/>
              <field name="entidad_bancaria_ids"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="action_metodo_pago" model="ir.actions.act_window">
      <field name="name">Métodos de Pago</field>
      <field name="res_model">upopark.metodo_pago</field>
      <field name="view_mode">list,form</field>
    </record>
    </data>
</odoo>
