<odoo>
  <record id="upopark_tipo_vehiculo_form_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.form</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <form string="Tipo de Vehiculo">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="cDescripcion" />
          </group>
          <notebook>
            <page name="vehiculos_registrados" string="Vehiculos Registrados">
              <group>
                <field name="vehiculo_ids" widget="one2many" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_tipo_vehiculo_list_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.list</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <list string="Tipos de Vehiculo">
        <field name="name" />
        <field name="cDescripcion" />
      </list>
    </field>
  </record>

  <record id="tipo_vehiculo_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de Vehiculo</field>
    <field name="res_model">upopark.tipo_vehiculo</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Crea el primer tipo de vehiculo en el sistema</p>
    </field>
  </record>
</odoo>