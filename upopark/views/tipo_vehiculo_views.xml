<odoo>
  <record id="upopark_tipo_vehiculo_form_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.form</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <form string="Tipo de Vehiculo">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="descripcion" />
          </group>
          <notebook>
            <page name="vehiculos_registrados" string="Vehiculos Registrados">
              <group>
                <field name="vehiculo_ids" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_tipo_vehiculo_list_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.list</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <list string="Tipos de Vehiculo">
        <field name="name" />
        <field name="descripcion" />
      </list>
    </field>
  </record>

  <record id="upopark_tipo_vehiculo_graph_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.graph</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <graph string="Tipos de Vehiculo" type="pie">
        <field name="name" type="row" />
      </graph>
    </field>
  </record>

  <record id="upopark_tipo_vehiculo_search_view" model="ir.ui.view">
    <field name="name">upopark.tipo_vehiculo.search</field>
    <field name="model">upopark.tipo_vehiculo</field>
    <field name="arch" type="xml">
      <search>
        <filter name="tipos_vacios" string="Tipos sin Vehiculos registrados" domain="[('vehiculo_ids', '=', False)]" />
      </search>
    </field>
  </record>

  <record id="tipo_vehiculo_list_action" model="ir.actions.act_window">
    <field name="name">Tipos de Vehiculo</field>
    <field name="res_model">upopark.tipo_vehiculo</field>
    <field name="search_view_id" ref="upopark_tipo_vehiculo_search_view" />
    <field name="view_mode">list,form,graph</field>
    <field name="help" type="html">
      <p>Crea el primer tipo de vehiculo en el sistema</p>
    </field>
  </record>
</odoo>