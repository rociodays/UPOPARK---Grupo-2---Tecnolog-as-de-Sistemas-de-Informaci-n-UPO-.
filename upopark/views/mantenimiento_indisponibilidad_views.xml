<odoo>
    <record id="view_mantenimiento_indisponibilidad_list" model="ir.ui.view">
        <field name="name">upopark.indisponibilidad.list</field>
        <field name="model">upopark.indisponibilidad</field>
        <field name="arch" type="xml">
            <list>
                <field name="strReferencia"/>
                <field name="recurso_id"/>
                <field name="strMotivo"/>
                <field name="dtInicio"/>
                <field name="dtFin"/>
                <field name="incidencia_id"/>
            </list>
        </field>
    </record>
    <record id="view_mantenimiento_indisponibilidad_form" model="ir.ui.view">
        <field name="name">upopark.indisponibilidad.form</field>
        <field name="model">upopark.indisponibilidad</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_mantenimiento_inspeccion_new)d" type="action"
                            string="Documentar con inspección" invisible="not id"
                            context="{'default_indisponibilidad_id': id}"/>
                </header>
                <sheet>
                    <group>
                        <field name="strReferencia" invisible="not id"/>
                        <field name="recurso_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="incidencia_id" options="{'no_create': True}"/>
                        <field name="dtInicio"/>
                        <field name="dtFin"/>
                        <field name="strMotivo"/>
                    </group>
                    <separator string="Inspecciones que documentan esta indisponibilidad"/>
                    <field name="inspeccion_ids" readonly="1">
                        <list>
                            <field name="strReferencia"/>
                            <field name="orden_trabajo_id"/>
                            <field name="dateFechaInspeccion"/>
                            <field name="resultado_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mantenimiento_indisponibilidad_search" model="ir.ui.view">
        <field name="name">upopark.indisponibilidad.search</field>
        <field name="model">upopark.indisponibilidad</field>
        <field name="arch" type="xml">
            <search>
                <field name="strReferencia"/>
                <field name="strMotivo"/>
                <field name="recurso_id"/>
                <field name="incidencia_id"/>
                <filter name="sin_fin" string="Sin fecha de fin" domain="[('dtFin', '=', False)]"/>
                <separator/>
                <filter name="con_incidencia" string="Con incidencia" domain="[('incidencia_id', '!=', False)]"/>
                <filter name="sin_incidencia" string="Sin incidencia" domain="[('incidencia_id', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="por_recurso" string="Recurso" context="{'group_by': 'recurso_id'}"/>
                    <filter name="por_incidencia" string="Incidencia" context="{'group_by': 'incidencia_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_mantenimiento_indisponibilidad_calendar" model="ir.ui.view">
        <field name="name">upopark.indisponibilidad.calendar</field>
        <field name="model">upopark.indisponibilidad</field>
        <field name="arch" type="xml">
            <calendar string="Indisponibilidades" date_start="dtInicio" date_stop="dtFin"
                      color="recurso_id" quick_create="false" delete="false">
                <field name="recurso_id"/>
                <field name="strMotivo"/>
            </calendar>
        </field>
    </record>
    <record id="view_mantenimiento_indisponibilidad_graph" model="ir.ui.view">
        <field name="name">upopark.indisponibilidad.graph</field>
        <field name="model">upopark.indisponibilidad</field>
        <field name="arch" type="xml">
            <graph string="Indisponibilidades por recurso" type="bar">
                <field name="recurso_id"/>
            </graph>
        </field>
    </record>
    <record id="action_mantenimiento_indisponibilidad" model="ir.actions.act_window">
        <field name="name">Indisponibilidades</field>
        <field name="res_model">upopark.indisponibilidad</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="search_view_id" ref="view_mantenimiento_indisponibilidad_search"/>
    </record>
    <record id="action_mantenimiento_indisponibilidad_new" model="ir.actions.act_window">
        <field name="name">Registrar indisponibilidad</field>
        <field name="res_model">upopark.indisponibilidad</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
