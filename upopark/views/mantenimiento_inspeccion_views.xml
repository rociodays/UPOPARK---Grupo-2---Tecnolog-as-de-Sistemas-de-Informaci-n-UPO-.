<odoo>
    <record id="view_mantenimiento_inspeccion_list" model="ir.ui.view">
        <field name="name">upopark.inspeccion.list</field>
        <field name="model">upopark.inspeccion</field>
        <field name="arch" type="xml">
            <list>
                <field name="strReferencia"/>
                <field name="orden_trabajo_id"/>
                <field name="indisponibilidad_id" optional="hide"/>
                <field name="inspector_id"/>
                <field name="dateFechaInspeccion"/>
                <field name="resultado_id"/>
            </list>
        </field>
    </record>

    <record id="view_mantenimiento_inspeccion_form" model="ir.ui.view">
        <field name="name">upopark.inspeccion.form</field>
        <field name="model">upopark.inspeccion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="strReferencia" invisible="not id"/>
                        <field name="orden_trabajo_id" options="{'no_create': True}"/>
                        <field name="indisponibilidad_id" options="{'no_create': True}"/>
                        <field name="inspector_id" required="resultado_id" options="{'no_create': True}"/>
                        <field name="dateFechaInspeccion" required="resultado_id"/>
                        <field name="resultado_id" options="{'no_create': True}"/>
                        <field name="strObservaciones"/>
                    </group>
                    <field name="elemento_inspeccionado_ids">
                        <list editable="bottom" delete="0">
                            <field name="iSecuencia"/>
                            <field name="strNombre"/>
                            <field name="selResultado"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mantenimiento_inspeccion_graph" model="ir.ui.view">
        <field name="name">upopark.inspeccion.graph</field>
        <field name="model">upopark.inspeccion</field>
        <field name="arch" type="xml">
            <graph string="Inspecciones por persona" type="bar">
                <field name="inspector_id"/>
            </graph>
        </field>
    </record>

    <record id="action_mantenimiento_inspeccion" model="ir.actions.act_window">
        <field name="name">Inspecciones</field>
        <field name="res_model">upopark.inspeccion</field>
        <field name="view_mode">list,form,graph</field>
    </record>

    <record id="action_mantenimiento_inspeccion_new" model="ir.actions.act_window">
        <field name="name">Abrir inspección</field>
        <field name="res_model">upopark.inspeccion</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
