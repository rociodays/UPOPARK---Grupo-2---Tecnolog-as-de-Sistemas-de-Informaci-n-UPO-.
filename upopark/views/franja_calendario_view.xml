<odoo>
  <record id="upopark_franja_calendario_form_view" model="ir.ui.view">
    <field name="name">upopark.franja_calendario.form</field>
    <field name="model">upopark.franja_calendario</field>
    <field name="arch" type="xml">
      <form string="Franja Calendario">
        <sheet layout="auto">
          <group>
            <field name="dia_semana" />
            <field name="hora_desde" />
            <field name="hora_hasta" />
            <field name="calendario_id" widget="many2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_franja_calendario_list_view" model="ir.ui.view">
    <field name="name">upopark.franja_calendario.list</field>
    <field name="model">upopark.franja_calendario</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="dia_semana" />
        <field name="hora_desde" />
        <field name="hora_hasta" />
        <field name="calendario_id" widget="many2one" />
      </list>
    </field>
  </record>

  <record id="franja_calendario_list_action" model="ir.actions.act_window">
    <field name="name">Franjas de Calendario</field>
    <field name="res_model">upopark.franja_calendario</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first time slot</p>
    </field>
  </record>
</odoo>