<odoo>
  <record id="upopark_organizacion_form_view" model="ir.ui.view">
    <field name="name">upopark.organizacion.form</field>
    <field name="model">upopark.organizacion</field>
    <field name="arch" type="xml">
      <form string="Organización">
        <sheet layout="auto">
          <group>
            <field name="name" />
            <field name="cif" />
            <field name="usuario_ids"  />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_organizacion_list_view" model="ir.ui.view">
    <field name="name">upopark.organizacion.list</field>
    <field name="model">upopark.organizacion</field>
    <field name="arch" type="xml">
      <list string="list_string">
        <field name="name" />
        <field name="cif" />
        <field name="usuario_ids"  />
      </list>
    </field>
  </record>

  <record id="organizacion_list_action" model="ir.actions.act_window">
    <field name="name">Organizaciones</field>
    <field name="res_model">upopark.organizacion</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create the first organization</p>
    </field>
  </record>
</odoo>