<odoo>
  <record id="upopark_zona_form_view" model="ir.ui.view">
    <field name="name">upopark.zona.form</field>
    <field name="model">upopark.zona</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="nombre" />
            <field name="codigo" />
            <field name="zona_nivel_acceso" widget="many2one" />
            <field name="zona_aparcamiento" widget="one2many" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_zona_list_view" model="ir.ui.view">
    <field name="name">upopark.zona.list</field>
    <field name="model">upopark.zona</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="nombre" />
            <field name="codigo" />
            <field name="zona_nivel_acceso" widget="many2one" />
            <field name="zona_aparcamiento" widget="one2many" />
      </list>
    </field>
  </record>

  <record id="zona_list_action" model="ir.actions.act_window">
    <field name="name">Zonas</field>
    <field name="res_model">upopark.zona</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea la primera zona</p>
    </field>
  </record>
</odoo>