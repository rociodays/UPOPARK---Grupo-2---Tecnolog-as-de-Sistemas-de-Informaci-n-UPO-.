<odoo>
    <record id="upopark_estado_punto_acceso_form_view" model="ir.ui.view">
        <field name="name">upopark.estado_punto_acceso.form</field>
        <field name="model">upopark.estado_punto_acceso</field>
        <field name="arch" type="xml">
            <form string="Estado Punto Acceso">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="descripcion" />
                    </group>
                    <notebook>
                        <page string="Puntos de Acceso">
                            <field name="punto_acceso_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_estado_punto_acceso_list_view" model="ir.ui.view">
        <field name="name">upopark.estado_punto_acceso.list</field>
        <field name="model">upopark.estado_punto_acceso</field>
        <field name="arch" type="xml">
            <list string="Estados Puntos de Acceso">
                <field name="name" />
                <field name="descripcion" />
            </list>
        </field>
    </record>
    <record id="estado_punto_acceso_list_action" model="ir.actions.act_window">
        <field name="name">Estados Puntos de Acceso</field>
        <field name="res_model">upopark.estado_punto_acceso</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>