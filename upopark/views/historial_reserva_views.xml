<odoo>
  <record id="upopark_historial_reserva_form_view" model="ir.ui.view">
    <field name="name">upopark.historial_reserva.form</field>
    <field name="model">upopark.historial_reserva</field>
    <field name="arch" type="xml">
      <form string="Historial de Reserva">
        <sheet layout="auto">
          <group>
            <group>
              <field name="name" widget="many2one" />
              <field name="estado_anterior_id" widget="many2one" />
              <field name="estado_nuevo_id" widget="many2one" />
            </group>
            <group>
              <field name="fFechaCambio" />
            </group>
          </group>
          <group>
            <field name="cNota" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_historial_reserva_list_view" model="ir.ui.view">
    <field name="name">upopark.historial_reserva.list</field>
    <field name="model">upopark.historial_reserva</field>
    <field name="arch" type="xml">
      <list string="Historial de Cambios">
        <field name="name" />
        <field name="fFechaCambio" />
        <field name="estado_anterior_id" />
        <field name="estado_nuevo_id" />
      </list>
    </field>
  </record>

  <record id="upopark_historial_reserva_calendar_view" model="ir.ui.view">
    <field name="name">upopark.historial_reserva.calendar</field>
    <field name="model">upopark.historial_reserva</field>
    <field name="arch" type="xml">
      <calendar string="Cambios de Estado" color="estado_nuevo_id" date_start="fFechaCambio" mode="month">
        <field name="name" />
        <field name="estado_nuevo_id" />
      </calendar>
    </field>
  </record>

  <record id="upopark_historial_reserva_graph_view" model="ir.ui.view">
    <field name="name">upopark.historial_reserva.graph</field>
    <field name="model">upopark.historial_reserva</field>
    <field name="arch" type="xml">
      <graph string="Cambios por Estado" type="line">
        <field name="estado_nuevo_id" type="row" />
      </graph>
    </field>
  </record>

  <record id="upopark_historial_reserva_search_view" model="ir.ui.view">
    <field name="name">upopark.historial_reserva.search</field>
    <field name="model">upopark.historial_reserva</field>
    <field name="arch" type="xml">
      <search>
        <filter name="historial_canceladas" string="Estado Nuevo Cancelacion" domain="[('estado_nuevo_id.name', 'ilike', 'cancelada')]" />
      </search>
    </field>
  </record>

  <record id="historial_reserva_list_action" model="ir.actions.act_window">
    <field name="name">Historial de Reservas</field>
    <field name="res_model">upopark.historial_reserva</field>
    <field name="search_view_id" ref="upopark_historial_reserva_search_view"/>
    <field name="view_mode">list,form,calendar,graph</field>
    <field name="help" type="html">
      <p>Crea el primer registro en el historial de reservas</p>
    </field>
  </record>
</odoo>