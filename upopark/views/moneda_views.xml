<odoo>
    <record id="upopark_moneda_form_view" model="ir.ui.view">
        <field name="name">upopark.moneda.form</field>
        <field name="model">upopark.moneda</field>
        <field name="arch" type="xml">
            <form string="Moneda">
                <sheet layout="auto">
                    <group>
                        <field name="name" />
                        <field name="simbolo" />
                        <field name="tasa_cambio" />
                    </group>
                    <notebook>
                        <page string="Tarifas">
                            <field name="tarifa_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="upopark_moneda_list_view" model="ir.ui.view">
        <field name="name">upopark.moneda.list</field>
        <field name="model">upopark.moneda</field>
        <field name="arch" type="xml">
            <list string="Monedas">
                <field name="name" />
                <field name="simbolo" />
                <field name="tasa_cambio" />
            </list>
        </field>
    </record>
    <record id="moneda_list_action" model="ir.actions.act_window">
        <field name="name">Monedas</field>
        <field name="res_model">upopark.moneda</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>