<odoo>
  <record id="upopark_estadoPlaza_form_view" model="ir.ui.view">
    <field name="name">upopark.estadoPlaza.form</field>
    <field name="model">upopark.estadoPlaza</field>
    <field name="arch" type="xml">
      <form string="Instructor">
        <sheet layout="auto">
          <group>
            <field name="estado" />
            <field name="estadoPlaza_plaza" widget="Many2one" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="upopark_estadoPlaza_list_view" model="ir.ui.view">
    <field name="name">upopark.estadoPlaza.list</field>
    <field name="model">upopark.estadoPlaza</field>
    <field name="arch" type="xml">
      <list string="list_string">
            <field name="estadoPlaza_plaza" widget="Many2one" />
      </list>
    </field>
  </record>

  <record id="estadoPlaza_list_action" model="ir.actions.act_window">
    <field name="name">Estados de plaza</field>
    <field name="res_model">upopark.estadoPlaza</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer estado de plaza</p>
    </field>
  </record>
</odoo>