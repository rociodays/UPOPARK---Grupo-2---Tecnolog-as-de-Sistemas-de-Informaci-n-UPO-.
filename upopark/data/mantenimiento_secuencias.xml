<odoo noupdate="1">
    <record id="sequence_mantenimiento_incidencia" model="ir.sequence">
        <field name="name">Incidencia UPOPARK</field>
        <field name="code">upopark.mantenimiento.incidencia</field>
        <field name="prefix">INC-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sequence_mantenimiento_orden_trabajo" model="ir.sequence">
        <field name="name">Orden de trabajo UPOPARK</field>
        <field name="code">upopark.mantenimiento.orden_trabajo</field>
        <field name="prefix">ORD-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sequence_mantenimiento_inspeccion" model="ir.sequence">
        <field name="name">Inspección UPOPARK</field>
        <field name="code">upopark.mantenimiento.inspeccion</field>
        <field name="prefix">INSP-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_mantenimiento_indisponibilidad" model="ir.sequence">
        <field name="name">Indisponibilidad UPOPARK</field>
        <field name="code">upopark.mantenimiento.indisponibilidad</field>
        <field name="prefix">IND-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
